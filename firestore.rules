rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'admin@farmerbox.com' ||
        request.auth.uid.matches('(?i).*admin.*')
      );
    }

    // User Profile collection (users/{uid}) and isolated subcollections
    match /users/{userId} {
      allow read, write: if !isAuthenticated() || (isOwner(userId) || isAdmin());

      match /{subcollection=**} {
        allow read, write: if !isAuthenticated() || (isOwner(userId) || isAdmin());
      }
    }

    // Hotels collection: Joiners see only their own hotels (joinedBy == uid), Admins see all
    match /hotels/{hotelId} {
      allow read: if !isAuthenticated() || (
        isAdmin() ||
        resource.data.joinedBy == request.auth.uid ||
        resource.data.joinerId == request.auth.uid
      );
      allow create: if !isAuthenticated() || (
        isAdmin() ||
        request.resource.data.joinedBy == request.auth.uid ||
        request.resource.data.joinerId == request.auth.uid
      );
      allow update, delete: if !isAuthenticated() || (
        isAdmin() ||
        resource.data.joinedBy == request.auth.uid ||
        resource.data.joinerId == request.auth.uid
      );
    }

    // Orders collection: Joiners see only their own orders (joinerId == uid), Admins see all
    match /orders/{orderId} {
      allow read: if !isAuthenticated() || (
        isAdmin() ||
        resource.data.joinerId == request.auth.uid ||
        resource.data.joinedBy == request.auth.uid
      );
      allow create: if !isAuthenticated() || (
        isAdmin() ||
        request.resource.data.joinerId == request.auth.uid ||
        request.resource.data.joinedBy == request.auth.uid
      );
      allow update: if !isAuthenticated() || (
        isAdmin() ||
        resource.data.joinerId == request.auth.uid
      );
      allow delete: if !isAuthenticated() || isAdmin();
    }

    // Products catalog: readable by all users (joiners + admin), writable by admin
    match /products/{productId} {
      allow read: if true;
      allow write: if !isAuthenticated() || isAdmin();
    }

    // Inventory items
    match /inventory/{itemId} {
      allow read: if true;
      allow write: if !isAuthenticated() || isAdmin();
    }

    // Zones
    match /zones/{zoneId} {
      allow read: if true;
      allow write: if !isAuthenticated() || isAdmin();
    }

    // Farmers
    match /farmers/{farmerId} {
      allow read: if true;
      allow write: if !isAuthenticated() || isAdmin();
    }

    // Joiners directory: visible to all authenticated users, managed by admin
    match /joiners/{joinerId} {
      allow read: if true;
      allow write: if !isAuthenticated() || isAdmin();
    }

    // Delivery Drivers
    match /drivers/{driverId} {
      allow read: if true;
      allow write: if !isAuthenticated() || isAdmin();
    }

    // Payments & Transactions
    match /payments/{paymentId} {
      allow read: if true;
      allow write: if !isAuthenticated() || isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // System Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if !isAuthenticated() || isAdmin();
    }
  }
}
